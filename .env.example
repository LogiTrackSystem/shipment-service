DATABASE_URL=postgresql://usuario:password@localhost:5432/shipment_db
RABBITMQ_URL=amqp://usuario:password@localhost:5672/
JWT_SECRET=cambia-esto-por-tu-propio-secreto-local
ROUTING_SERVICE_URL=http://localhost:8003
ENTREGA_AUTOMATICA=true
FLEET_SERVICE_URL=http://localhost:8000
BILLING_SERVICE_URL=http://localhost:8008
# Clave compartida con el gateway y los demás servicios (producción). Vacía = sin restricción (local).
INTERNAL_API_KEY=
# Código que solo conoce el administrador: permite registrarse como operador o gestor de flota (mínimo 8 caracteres).
# Vacío = nadie puede registrarse con esos roles (solo el administrador crea esas cuentas). Los clientes no lo necesitan.
CODIGO_REGISTRO_PERSONAL=
# Límite de intentos fallidos con ese código: REGISTRO_MAX_FALLOS dentro de REGISTRO_VENTANA_S segundos (por defecto 8 y 600).
# REGISTRO_MAX_FALLOS=8
# REGISTRO_VENTANA_S=600
